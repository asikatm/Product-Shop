@page "/customers"
@attribute [RequirePermission(Perms.CustomersView)]
@inject CustomerService CustomerService
@inject AuthState Auth

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    @if (Auth.Can(Perms.CustomersAdd)) { <a class="btn btn-primary" href="customers/new"><i class="bi bi-person-plus me-1"></i> Add Customer</a> }
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (customers == null)
{
    <p>Loading...</p>
}
else if (customers.Count == 0)
{
    <div class="alert alert-info">Ekhono kono customer nai. Sale er somoy phone number dile customer automatic save hoy.</div>
}
else
{
    <div class="row g-2 mb-3 align-items-center">
        <div class="col-md-5">
            <input class="form-control" placeholder="Naam, phone ba area diye khujun..." @bind="search" @bind:event="oninput" />
        </div>
        <div class="col-6 col-md-2">
            <select class="form-select" @bind="type">
                <option value="">Shob type</option>
                @foreach (var t in CustomerTypes.All)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="col-auto form-check ms-2">
            <input class="form-check-input" type="checkbox" id="dueOnly" @bind="dueOnly" />
            <label class="form-check-label" for="dueOnly">Shudhu baki wala</label>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Area</th>
                        <th class="text-end">Mot Kena</th>
                        <th class="text-end">Baki</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Filtered)
                    {
                        <tr>
                            <td>
                                <a href="customers/@c.Id">@c.Name</a>
                                @if (c.CustomerType != CustomerTypes.Regular)
                                {
                                    <span class="badge ms-1 @(c.CustomerType == CustomerTypes.Vip ? "bg-warning text-dark" : "bg-info text-dark")">@c.CustomerType</span>
                                }
                            </td>
                            <td class="text-nowrap">@PhoneHelper.Pretty(c.Phone)</td>
                            <td class="small">@c.City</td>
                            <td class="text-end">@Fmt.Money(c.TotalPurchase)</td>
                            <td class="text-end @(c.TotalDue > 0 ? "text-danger fw-semibold" : "")">@Fmt.Money(c.TotalDue)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="customers/@c.Id">Details</a>
                                @if (Auth.Can(Perms.CustomersEdit)) { <a class="btn btn-sm btn-outline-secondary" href="customers/edit/@c.Id" title="Edit"><i class="bi bi-pencil"></i></a> }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="3" class="text-end">Total (@Filtered.Count() jon)</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(c => c.TotalPurchase))</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(c => c.TotalDue))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private List<Customer>? customers;
    private string? error;
    private bool dueOnly;
    private string type = string.Empty;
    private string search = string.Empty;

    private IEnumerable<Customer> Filtered => customers!
        .Where(c => !dueOnly || c.TotalDue > 0)
        .Where(c => type.Length == 0 || c.CustomerType == type)
        .Where(c => string.IsNullOrWhiteSpace(search)
                 || c.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                 || c.Phone.Contains(search.Replace("-", "").Trim())
                 || (c.City?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            customers = await CustomerService.GetAllAsync();
        }
        catch (Exception ex)
        {
            customers = new List<Customer>();
            error = "Data ana jay nai: " + ex.Message;
        }
    }
}
