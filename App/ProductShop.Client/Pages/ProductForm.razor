            };
        }
    }

    private string DiscountUnit
    {
        get => product!.DiscountIsPercent ? "%" : "tk";
        set => product!.DiscountIsPercent = value == "%";
    }

    protected override async Task OnParametersSetAsync()
    {
        error = null;
        errors.Clear();

        try
        {
            categories = await CatalogService.GetCategoriesAsync();
            brands = await CatalogService.GetBrandsAsync();
            shops = await CatalogService.GetShopsAsync();
            suppliers = await CatalogService.GetSuppliersAsync();
            product = IsEdit ? await ProductService.GetByIdAsync(Id!.Value) : NewProduct();
            if (product != null) InitState(product);
        }
        catch (Exception ex)
        {
            error = "Data load kora jay nai: " + ex.Message;
        }
    }

    private Product NewProduct() => new()
    {
        Status = ProductStatus.Active,
        ShopId = shops.Count == 1 ? shops[0].Id : null
    };

    // Purono variant theke size / color / dam er chip gulo set kora
    private void InitState(Product p)
    {
        sizes = ProductOptions.Sizes.ToList();
        colors = ColorPalette.ToList();
        selectedSizes.Clear();
        selectedColors.Clear();

        foreach (var v in p.Variants)
        {
            if (!IsSelected(sizes, v.Size)) sizes.Add(v.Size);
            if (!IsSelected(selectedSizes, v.Size)) selectedSizes.Add(v.Size);

            if (string.IsNullOrWhiteSpace(v.Color)) continue;
            if (!colors.Any(c => Same(c.Name, v.Color))) colors.Add(new ColorOption(v.Color, HexOf(v.Color)));
            if (!IsSelected(selectedColors, v.Color)) selectedColors.Add(v.Color);
        }

        // Purono product e product-level dam na thakle prothom variant theke
        var first = p.Variants.FirstOrDefault();
        if (p.Price == 0 && first != null) p.Price = first.Price;
        if (p.PurchasePrice == 0 && first != null) p.PurchasePrice = first.PurchasePrice;

        lowStockAlert = first?.ReorderLevel ?? 5;
        oldCode = p.Code;
        oldPurchasePrice = p.PurchasePrice;
        oldPrice = p.Price;
        wasDraft = p.Status == ProductStatus.Draft;
    }

    // ---------- Sizes / colors ----------

    private static bool Same(string? a, string? b) => string.Equals(a?.Trim(), b?.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool IsSelected(List<string> list, string value) => list.Any(x => Same(x, value));

    private void ToggleSize(string size)
    {
        if (IsSelected(selectedSizes, size)) selectedSizes.RemoveAll(x => Same(x, size));
        else selectedSizes.Add(size);
        SyncVariants();
    }

    private void ToggleColor(string color)
    {
        if (IsSelected(selectedColors, color)) selectedColors.RemoveAll(x => Same(x, color));
        else selectedColors.Add(color);
        SyncVariants();
    }

    private void OnSizeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddSize();
    }

    private void AddSize()
    {
        var size = newSize.Trim();
        if (size.Length == 0) return;

        if (!IsSelected(sizes, size)) sizes.Add(size);
        if (!IsSelected(selectedSizes, size)) selectedSizes.Add(size);
        newSize = string.Empty;
        addingSize = false;
        SyncVariants();
    }

    private void OnColorKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddColor();
    }

    private void AddColor()
    {
        var name = newColorName.Trim();
        if (name.Length == 0) return;

        var existing = colors.FirstOrDefault(c => Same(c.Name, name));
        if (existing == null) colors.Add(new ColorOption(name, newColorHex));
        if (!IsSelected(selectedColors, name)) selectedColors.Add(existing?.Name ?? name);
        newColorName = string.Empty;
        addingColor = false;
        SyncVariants();
    }

    private string HexOf(string color)
    {
        if (string.IsNullOrWhiteSpace(color)) return "transparent";
        var option = colors.FirstOrDefault(c => Same(c.Name, color));
        if (option != null) return option.Hex;
        return KnownColors.TryGetValue(color.Trim(), out var hex) ? hex : "#adb5bd";
    }

    private static bool IsLight(string hex)
    {
        if (hex.Length != 7) return true;
        var r = Convert.ToInt32(hex.Substring(1, 2), 16);
        var g = Convert.ToInt32(hex.Substring(3, 2), 16);
        var b = Convert.ToInt32(hex.Substring(5, 2), 16);
        return 0.299 * r + 0.587 * g + 0.114 * b > 160;
    }

    // Selected size x color er shob combination er row banano.
    // Notun (unsaved) row deselect korle muche jay, purono row thake (✕ diye remove korte hoy).
    private void SyncVariants()
    {
        var p = product!;
        var colorList = selectedColors.Count == 0 ? new List<string> { string.Empty } : selectedColors;

        p.Variants.RemoveAll(v => v.Id == 0 && (!IsSelected(selectedSizes, v.Size) || !colorList.Any(c => Same(c, v.Color))));

        foreach (var size in sizes.Where(s => IsSelected(selectedSizes, s)))
        foreach (var color in colorList)
        {
            if (p.Variants.Any(v => Same(v.Size, size) && Same(v.Color, color))) continue;

            p.Variants.Add(new ProductVariant
            {
                Size = size,
                Color = color,
                Sku = SuggestSku(p.Code, size, color),
                PurchasePrice = p.PurchasePrice,
                Price = p.Price,
                ReorderLevel = lowStockAlert
            });
        }

        // Size er order onujayi, tarpor color
        var sorted = p.Variants
            .OrderBy(v => { var i = sizes.FindIndex(s => Same(s, v.Size)); return i < 0 ? int.MaxValue : i; })
            .ThenBy(v => { var i = colors.FindIndex(c => Same(c.Name, v.Color)); return i < 0 ? int.MaxValue : i; })
            .ToList();
        p.Variants.Clear();
        p.Variants.AddRange(sorted);
    }

    // Jemon "SH-MN-0012-WHITE-M". Code na thakle server nije SKU banabe.
    private string? SuggestSku(string? code, string size, string color)
    {
        if (string.IsNullOrWhiteSpace(code)) return null;
        var parts = new[] { code.Trim(), color.Replace(" ", "").ToUpperInvariant(), size.Replace(" ", "").ToUpperInvariant() };
        var sku = string.Join("-", parts.Where(x => x.Length > 0));
        return sku.Length <= 40 ? sku : null;
    }

    private void OnCodeChanged()
    {
        foreach (var v in product!.Variants.Where(v => v.Id == 0 && (v.Sku == null || v.Sku == SuggestSku(oldCode, v.Size, v.Color))))
            v.Sku = SuggestSku(product.Code, v.Size, v.Color);
        oldCode = product.Code;
    }

    // ---------- Pricing ----------

    private void ApplyPurchasePrice()
    {
        foreach (var v in product!.Variants.Where(v => v.PurchasePrice == oldPurchasePrice))
            v.PurchasePrice = product.PurchasePrice;
        oldPurchasePrice = product.PurchasePrice;
    }

    private void ApplyPrice()
    {
        foreach (var v in product!.Variants.Where(v => v.Price == oldPrice))
            v.Price = product.Price;
        oldPrice = product.Price;
    }

    private static string Tk(decimal value) => "৳" + value.ToString("#,0.##");

    // ---------- Images ----------

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        var room = MaxImages - product!.Images.Count;
        if (room <= 0) return;

        uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxImages).Take(room))
            {
                if (file.ContentType is not ("image/jpeg" or "image/png"))
                {
                    imageError = $"'{file.Name}': shudhu JPG / PNG deya jabe.";
                    continue;
                }
                if (file.Size > MaxImageBytes)
                {
                    imageError = $"'{file.Name}': 2MB er beshi.";
                    continue;
                }

                await using var stream = file.OpenReadStream(MaxImageBytes);
                var url = await ProductService.UploadImageAsync(stream, file.Name, file.ContentType);
                product.Images.Add(new ProductImage { Url = url });
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            imageError = "Chobi upload hoy nai: " + ex.Message;
        }
        finally
        {
            uploading = false;
        }
    }

    private void MakeMain(ProductImage img)
    {
        product!.Images.Remove(img);
        product.Images.Insert(0, img);
    }

    // ---------- Validation / save ----------

    private string Cls(string key) => errors.ContainsKey(key) ? "is-invalid" : string.Empty;

    private RenderFragment? Err(string key) =>
        errors.TryGetValue(key, out var msg) ? @<div class="invalid-feedback d-block">@msg</div> : null;

    // Draft e shudhu naam lage, publish e shob required field
    private void Validate(bool publish)
    {
        var p = product!;
        errors.Clear();

        if (string.IsNullOrWhiteSpace(p.Name)) errors["Name"] = "Product name dite hobe.";
        if (p.Discount < 0 || (p.DiscountIsPercent && p.Discount > 100)) errors["Discount"] = "Discount 0-100% er moddhe hobe.";
        if (p.VatPercent < 0 || p.VatPercent > 100) errors["Vat"] = "VAT 0-100% er moddhe hobe.";
        if (p.PurchasePrice < 0) errors["PurchasePrice"] = "Negative hote parbe na.";
        if (p.Price < 0) errors["Price"] = "Negative hote parbe na.";
        if (lowStockAlert < 0) errors["LowStock"] = "Negative hote parbe na.";
        if (p.Variants.Any(v => string.IsNullOrWhiteSpace(v.Size)))
            errors["Variants"] = "Protiti variant e size dite hobe.";
        else if (p.Variants.Any(v => v.Price < 0 || v.Quantity < 0))
            errors["Variants"] = "Variant er dam ba stock negative hote parbe na.";

        if (!publish) return;

        if (string.IsNullOrWhiteSpace(p.Code)) errors["Code"] = "Product code dite hobe.";
        if (string.IsNullOrWhiteSpace(p.Gender)) errors["Gender"] = "Gender select korun.";
        if (p.CategoryId == null) errors["Category"] = "Category select korun.";
        if (p.PurchasePrice <= 0) errors["PurchasePrice"] = "Purchase price dite hobe.";
        if (p.Price <= 0) errors["Price"] = "Selling price dite hobe.";
        if (p.ShopId == null) errors["Shop"] = "Shop / outlet select korun.";
        if (p.Variants.Count == 0) errors.TryAdd("Variants", "Kompokkhe ekta size select korun.");
    }

    private async Task SaveAsync(bool publish)
    {
        error = null;
        submitted = true;
        lastPublish = publish;
        Validate(publish);
        if (errors.Count > 0)
        {
            error = FixFieldsMessage;
            return;
        }

        var p = product!;
        var previousStatus = p.Status;
        if (!publish) p.Status = ProductStatus.Draft;
        else if (p.Status == ProductStatus.Draft) p.Status = ProductStatus.Active;

        foreach (var v in p.Variants)
            v.ReorderLevel = lowStockAlert;

        saving = true;
        try
        {
            if (IsEdit)
                await ProductService.UpdateAsync(p);
            else
                await ProductService.CreateAsync(p);

            Nav.NavigateTo("products");
        }
        catch (Exception ex)
        {
            p.Status = previousStatus;
            error = "Save kora jay nai: " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
