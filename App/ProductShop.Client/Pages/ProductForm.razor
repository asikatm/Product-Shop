@page "/product/add"
@page "/product/edit/{Id:int}"
@attribute [RequirePermission(Perms.ProductsAdd, Perms.ProductsEdit)]
@inject ProductService ProductService
@inject CatalogService CatalogService
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit product" : "Add new product")</PageTitle>

@* Prothom save er por protiti change e abar check hoy, jate lal ghor sathe sathe thik hoye jay *@
@{
    if (submitted && product != null)
    {
        Validate(lastPublish);
        if (errors.Count == 0 && error == FixFieldsMessage) error = null;
    }
}

<div class="pf">
    <div class="page-head">
        <div>
            <h1 class="h4 d-flex align-items-center gap-2">
                @(IsEdit ? "Edit product" : "Add new product")
                @if (product != null && IsEdit)
                {
                    <span class="badge @StatusBadge(product.Status) fs-6 fw-semibold">@product.Status</span>
                }
            </h1>
            <div class="pf-crumb">
                <a href="">Dashboard</a> / <a href="products">Products</a> / @(IsEdit ? product?.Name ?? "Edit" : "Add")
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i> @error</div>
    }

    @if (product == null)
    {
        @if (string.IsNullOrEmpty(error))
        {
            <div class="loading">Loading...</div>
        }
    }
    else
    {
        <div class="row g-3">
            <div class="col-xl-8">

                @* ---------- Basic information ---------- *@
                <section class="pf-card">
                    <h2 class="pf-title"><i class="bi bi-info-circle"></i> Basic information</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="pf-label">Product name <span class="req">*</span></label>
                            <input class="form-control @Cls("Name")" @bind="product.Name" @bind:event="oninput" placeholder="Men's cotton casual shirt" maxlength="100" />
                            @Err("Name")
                        </div>
                        <div class="col-md-6">
                            <label class="pf-label">SKU / product code <span class="req">*</span></label>
                            <div class="input-group has-validation">
                                <span class="input-group-text"><i class="bi bi-upc"></i></span>
                                <input class="form-control @Cls("Code")" @bind="product.Code" @bind:after="OnCodeChanged" placeholder="SH-MN-0012" maxlength="30" />
                                @Err("Code")
                            </div>
                            <div class="pf-hint mt-1">Variant er SKU ei code theke toiri hoy.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="pf-label">Barcode</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input class="form-control" @bind="product.Barcode" placeholder="8901234567890" maxlength="40" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="pf-label">Description</label>
                            <textarea class="form-control" rows="3" @bind="product.Description" @bind:event="oninput" placeholder="Fabric, GSM, fit, wash care..." maxlength="500"></textarea>
                            <div class="pf-hint text-end mt-1">@(product.Description?.Length ?? 0)/500</div>
                        </div>
                    </div>
                </section>

                @* ---------- Category and material ---------- *@
                <section class="pf-card">
                    <h2 class="pf-title">
                        <i class="bi bi-grid"></i> Category and material
                        <a class="pf-title-link" href="catalog"><i class="bi bi-gear me-1"></i>Manage list</a>
                    </h2>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="pf-label">Gender <span class="req">*</span></label>
                            <select class="form-select @Cls("Gender")" @bind="product.Gender">
                                <option value="">-- Select --</option>
                                @foreach (var o in ProductOptions.Genders)
                                {
                                    <option value="@o">@o</option>
                                }
                            </select>
                            @Err("Gender")
                        </div>
                        <div class="col-md-4">
                            <label class="pf-label">Category <span class="req">*</span></label>
                            <select class="form-select @Cls("Category")" @bind="product.CategoryId">
                                <option value="">-- Select --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            @Err("Category")
                        </div>
                        <div class="col-md-4">
                            <label class="pf-label">Brand</label>
                            <select class="form-select" @bind="product.BrandId">
                                <option value="">-- None --</option>
                                @foreach (var b in brands)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Fabric / material</label>
                            <OptionSelect Value="@product.Fabric" ValueChanged="v => product.Fabric = v" Options="ProductOptions.Fabrics" />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Fit type</label>
                            <OptionSelect Value="@product.FitType" ValueChanged="v => product.FitType = v" Options="ProductOptions.FitTypes" />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Sleeve</label>
                            <OptionSelect Value="@product.Sleeve" ValueChanged="v => product.Sleeve = v" Options="ProductOptions.Sleeves" />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Season</label>
                            <OptionSelect Value="@product.Season" ValueChanged="v => product.Season = v" Options="ProductOptions.Seasons" />
                        </div>
                    </div>
                </section>

                @* ---------- Pricing ---------- *@
                <section class="pf-card">
                    <h2 class="pf-title"><i class="bi bi-currency-exchange"></i> Pricing</h2>
                    <div class="row g-3">
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Purchase price <span class="req">*</span></label>
                            <div class="input-group has-validation">
                                <span class="input-group-text">৳</span>
                                <input type="number" min="0" step="0.01" class="form-control @Cls("PurchasePrice")" @bind="product.PurchasePrice" @bind:after="ApplyPurchasePrice" />
                                @Err("PurchasePrice")
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Selling price (MRP) <span class="req">*</span></label>
                            <div class="input-group has-validation">
                                <span class="input-group-text">৳</span>
                                <input type="number" min="0" step="0.01" class="form-control @Cls("Price")" @bind="product.Price" @bind:after="ApplyPrice" />
                                @Err("Price")
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">Discount</label>
                            <div class="d-flex gap-2">
                                <input type="number" min="0" step="0.01" class="form-control @Cls("Discount")" @bind="product.Discount" />
                                <select class="form-select pf-unit" @bind="DiscountUnit">
                                    <option value="%">%</option>
                                    <option value="tk">৳</option>
                                </select>
                            </div>
                            @Err("Discount")
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="pf-label">VAT</label>
                            <div class="input-group has-validation">
                                <input type="number" min="0" max="100" step="0.01" class="form-control @Cls("Vat")" @bind="product.VatPercent" />
                                <span class="input-group-text">%</span>
                                @Err("Vat")
                            </div>
                        </div>
                    </div>
                    <div class="pf-summary mt-3">
                        <span>Final price: <strong>@Tk(product.FinalPrice)</strong></span>
                        <span class="@(Profit < 0 ? "text-danger" : "pf-profit")">Profit: <strong>@Tk(Profit)</strong> @(MarginText)</span>
                        @if (product.VatPercent > 0)
                        {
                            <span class="text-muted">With VAT: @Tk(PriceWithVat)</span>
                        }
                    </div>
                    <div class="pf-hint mt-2">Purchase / MRP change korle je variant er dam ager moto chilo, shegulo o update hobe.</div>
                </section>

                @* ---------- Size and color variants ---------- *@
                <section class="pf-card">
                    <h2 class="pf-title"><i class="bi bi-palette"></i> Size and color variants</h2>

                    <label class="pf-label">Sizes <span class="req">*</span></label>
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        @foreach (var s in sizes)
                        {
                            <button type="button" class="pf-chip @(IsSelected(selectedSizes, s) ? "active" : "")" @onclick="() => ToggleSize(s)">@s</button>
                        }
                        @if (addingSize)
                        {
                            <div class="input-group input-group-sm pf-inline-add">
                                <input class="form-control" placeholder="32, Free..." @bind="newSize" @bind:event="oninput" @onkeydown="OnSizeKey" maxlength="20" />
                                <button type="button" class="btn btn-primary" @onclick="AddSize">Add</button>
                                <button type="button" class="btn btn-light border" @onclick="() => addingSize = false">✕</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="pf-chip pf-chip-dashed" title="Onno size" @onclick="() => addingSize = true"><i class="bi bi-plus"></i></button>
                        }
                    </div>

                    <label class="pf-label">Colors</label>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @foreach (var c in colors)
                        {
                            var on = IsSelected(selectedColors, c.Name);
                            <button type="button" class="pf-swatch @(on ? "active" : "")" style="background:@c.Hex" title="@c.Name" @onclick="() => ToggleColor(c.Name)">
                                @if (on)
                                {
                                    <i class="bi bi-check-lg" style="color:@(IsLight(c.Hex) ? "#212529" : "#fff")"></i>
                                }
                            </button>
                        }
                        @if (addingColor)
                        {
                            <div class="input-group input-group-sm pf-inline-add">
                                <input type="color" class="form-control form-control-color" @bind="newColorHex" title="Rong" />
                                <input class="form-control" placeholder="Color name" @bind="newColorName" @bind:event="oninput" @onkeydown="OnColorKey" maxlength="30" />
                                <button type="button" class="btn btn-primary" @onclick="AddColor">Add</button>
                                <button type="button" class="btn btn-light border" @onclick="() => addingColor = false">✕</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => addingColor = true">
                                <i class="bi bi-plus"></i> Add color
                            </button>
                        }
                    </div>
                    <div class="pf-hint mt-1">
                        @(selectedColors.Count == 0 ? "Kono color select kora nai (shudhu size diye variant hobe)." : "Selected: " + string.Join(", ", selectedColors))
                    </div>

                    <div class="table-responsive mt-3">
                        <table class="table pf-table align-middle mb-0 @Cls("Variants")">
                            <thead>
                                <tr>
                                    <th>Variant</th>
                                    <th style="min-width:170px">SKU</th>
                                    <th style="width:140px">Price</th>
                                    <th style="width:110px">Stock</th>
                                    <th style="width:40px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (product.Variants.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted text-center py-4">
                                            <i class="bi bi-arrow-up-circle d-block fs-4 mb-1"></i>
                                            Upore size (ar color) select korun, variant gulo ekhane ashbe.
                                        </td>
                                    </tr>
                                }
                                @foreach (var v in product.Variants)
                                {
                                    <tr @key="v">
                                        <td class="text-nowrap">
                                            <span class="pf-dot" style="background:@HexOf(v.Color)"></span>
                                            @(string.IsNullOrWhiteSpace(v.Color) ? v.Size : $"{v.Color} / {v.Size}")
                                        </td>
                                        <td><input class="pf-cell" @bind="v.Sku" placeholder="Auto" maxlength="40" /></td>
                                        <td>
                                            <div class="d-flex align-items-center"><span class="text-muted me-1">৳</span><input type="number" min="0" step="0.01" class="pf-cell" @bind="v.Price" /></div>
                                        </td>
                                        <td>
                                            @* Purono variant er stock Stock In / Sale diye change hoy *@
                                            <input type="number" min="0" class="pf-cell" @bind="v.Quantity" disabled="@(v.Id > 0)" title="@(v.Id > 0 ? "Stock In / Sale diye change korun" : "Opening stock")" />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Remove" @onclick="() => product.Variants.Remove(v)"><i class="bi bi-x-lg"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @Err("Variants")
                    @if (product.Variants.Count > 0)
                    {
                        <div class="pf-hint mt-2">@product.Variants.Count ta variant, mot @product.Variants.Sum(v => v.Quantity) pcs @(IsEdit ? "· Purono variant er stock barate \"Stock In\" use korun." : "(opening stock)")</div>
                    }
                </section>

                @* ---------- Product images ---------- *@
                <section class="pf-card">
                    <h2 class="pf-title"><i class="bi bi-image"></i> Product images <span class="pf-hint fw-normal ms-1">@product.Images.Count/@MaxImages</span></h2>
                    <div class="pf-images">
                        @foreach (var img in product.Images)
                        {
                            var index = product.Images.IndexOf(img);
                            <div class="pf-tile" @key="img.Url">
                                <img src="@ProductService.ImageUrl(img.Url)" alt="Product image" />
                                @if (index == 0)
                                {
                                    <span class="pf-badge">Main</span>
                                }
                                else
                                {
                                    <button type="button" class="pf-tile-btn start-0 ms-1" title="Main image korun" @onclick="() => MakeMain(img)"><i class="bi bi-star"></i></button>
                                }
                                <button type="button" class="pf-tile-btn end-0 me-1" title="Remove" @onclick="() => product.Images.Remove(img)"><i class="bi bi-x-lg"></i></button>
                            </div>
                        }
                        @if (product.Images.Count < MaxImages)
                        {
                            <label class="pf-tile pf-tile-add">
                                <InputFile OnChange="OnImagesSelected" multiple accept=".jpg,.jpeg,.png" class="d-none" disabled="@uploading" />
                                @if (uploading)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Uploading...</span>
                                }
                                else
                                {
                                    <i class="bi @(product.Images.Count == 0 ? "bi-cloud-arrow-up" : "bi-plus-lg") fs-3"></i>
                                    <span>@(product.Images.Count == 0 ? "Main image" : "Add more")</span>
                                }
                            </label>
                        }
                    </div>
                    <div class="pf-hint mt-2">JPG/PNG, max 2MB, 800x800 recommended. Prothom chobi ta main image; ☆ diye main bodlano jay.</div>
                    @if (!string.IsNullOrEmpty(imageError))
                    {
                        <div class="text-danger small mt-1">@imageError</div>
                    }
                </section>
            </div>

            @* ---------- Dan pash: preview, status, checklist ---------- *@
            <div class="col-xl-4">
                <section class="pf-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="pf-label mb-0">Preview</span>
                        <span class="badge @StatusBadge(product.Status)">@product.Status</span>
                    </div>
                    <div class="pp-image">
                        @if (product.Images.Count > 0)
                        {
                            <img src="@ProductService.ImageUrl(product.Images[0].Url)" alt="" />
                        }
                        else
                        {
                            <i class="bi bi-image"></i>
                        }
                    </div>
                    <div class="small text-muted">@string.Join(" · ", new[] { CategoryName, BrandName, product.Gender }.Where(x => !string.IsNullOrEmpty(x)))</div>
                    <div class="fw-semibold fs-6 text-break">@(string.IsNullOrWhiteSpace(product.Name) ? "Product name" : product.Name)</div>
                    @if (!string.IsNullOrWhiteSpace(product.Code))
                    {
                        <div class="small text-muted">@product.Code</div>
                    }
                    <div class="mt-2">
                        <span class="pp-price">@Tk(product.FinalPrice)</span>
                        @if (product.Discount > 0 && product.Price > product.FinalPrice)
                        {
                            <span class="pp-mrp">@Tk(product.Price)</span>
                            <span class="badge bg-danger-subtle text-danger-emphasis ms-1">@(product.DiscountIsPercent ? $"-{product.Discount:0.##}%" : $"-{Tk(product.Discount)}")</span>
                        }
                    </div>
                    @if (selectedColors.Count > 0)
                    {
                        <div class="d-flex gap-1 mt-2">
                            @foreach (var c in selectedColors)
                            {
                                <span class="pf-dot" style="background:@HexOf(c)" title="@c"></span>
                            }
                        </div>
                    }
                    <div class="pp-stats">
                        <div class="pp-stat">
                            <div class="pp-stat-label">Variants</div>
                            <div class="pp-stat-value">@product.Variants.Count</div>
                        </div>
                        <div class="pp-stat">
                            <div class="pp-stat-label">Stock</div>
                            <div class="pp-stat-value">@product.Variants.Sum(v => v.Quantity) pcs</div>
                        </div>
                        <div class="pp-stat">
                            <div class="pp-stat-label">Profit / pc</div>
                            <div class="pp-stat-value @(Profit < 0 ? "text-danger" : "text-success")">@Tk(Profit)</div>
                        </div>
                        <div class="pp-stat">
                            <div class="pp-stat-label">Margin</div>
                            <div class="pp-stat-value">@(Margin is decimal m ? $"{m:0.#}%" : "-")</div>
                        </div>
                    </div>
                </section>

                <section class="pf-card">
                    <h2 class="pf-title"><i class="bi bi-shop"></i> Status &amp; inventory</h2>

                    <label class="pf-label">Status</label>
                    <div class="d-flex gap-2 mb-3">
                        @foreach (var s in ProductStatus.All)
                        {
                            <button type="button" class="pf-chip flex-fill @(product.Status == s ? "active" : "")" @onclick="() => product.Status = s">@s</button>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="pf-label">Shop / outlet <span class="req">*</span></label>
                        <select class="form-select @Cls("Shop")" @bind="product.ShopId">
                            <option value="">-- Select --</option>
                            @foreach (var s in shops)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        @Err("Shop")
                    </div>
                    <div class="mb-3">
                        <label class="pf-label">Supplier</label>
                        <select class="form-select" @bind="product.SupplierId">
                            <option value="">-- None --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="pf-label">Low stock alert</label>
                        <div class="input-group has-validation">
                            <input type="number" min="0" class="form-control @Cls("LowStock")" @bind="lowStockAlert" />
                            <span class="input-group-text">pcs</span>
                            @Err("LowStock")
                        </div>
                        <div class="pf-hint mt-1">Protiti size/color er stock eto ba kom hole dashboard e dekhabe.</div>
                    </div>
                    <div>
                        <label class="pf-label">Tags</label>
                        <input class="form-control" @bind="product.Tags" placeholder="summer, cotton, office wear" maxlength="200" />
                    </div>
                </section>

                <section class="pf-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="pf-label mb-0">Publish checklist</span>
                        <span class="small text-muted">@Checklist.Count(x => x.Done)/@Checklist.Count</span>
                    </div>
                    <div class="progress mb-3" style="height:6px">
                        <div class="progress-bar" style="width:@(Checklist.Count(x => x.Done) * 100 / Checklist.Count)%; background:var(--ui-primary)"></div>
                    </div>
                    <ul class="cf-checklist">
                        @foreach (var item in Checklist)
                        {
                            <li class="@(item.Done ? "done" : "")"><i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-circle")"></i> @item.Label</li>
                        }
                    </ul>
                    <div class="pf-hint">Draft save e shudhu naam lage. Publish e shob dorkar.</div>
                </section>
            </div>
        </div>

        @* ---------- Sticky save bar ---------- *@
        <div class="pf-actions">
            <span class="pf-actions-note d-none d-md-inline">
                <i class="bi bi-info-circle me-1"></i>@product.Variants.Count ta variant · @product.Variants.Sum(v => v.Quantity) pcs · @Tk(product.FinalPrice)
            </span>
            <a class="btn btn-light border" href="products">Cancel</a>
            <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => SaveAsync(false)">
                <i class="bi bi-file-earmark me-1"></i>Save draft
            </button>
            <button type="button" class="btn btn-primary px-3" disabled="@Busy" @onclick="() => SaveAsync(true)">
                @if (saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span><span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2 me-1"></i><span>@PublishLabel</span>
                }
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private const int MaxImages = 8;
    private const long MaxImageBytes = 2 * 1024 * 1024;

    private record ColorOption(string Name, string Hex);

    private static readonly ColorOption[] ColorPalette =
    {
        new("White", "#ffffff"), new("Black", "#212529"), new("Navy", "#0b2c4d"), new("Maroon", "#a4262c"),
        new("Green", "#5c9a2a"), new("Blue", "#2f6fd1"), new("Grey", "#8a8f98"), new("Beige", "#d9c7a7")
    };

    private static readonly Dictionary<string, string> KnownColors = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Red"] = "#d63031", ["Yellow"] = "#f5c518", ["Pink"] = "#f06292", ["Brown"] = "#795548", ["Orange"] = "#f57c00",
        ["Purple"] = "#7b1fa2", ["Olive"] = "#708238", ["Sky Blue"] = "#5bc0eb", ["Cream"] = "#f3e9d2", ["Off White"] = "#f5f3ee"
    };

    private Product? product;
    private List<Category> categories = new();
    private List<Brand> brands = new();
    private List<Shop> shops = new();
    private List<Supplier> suppliers = new();
    private string? error;
    private string? imageError;
    private bool saving;
    private bool uploading;
    private readonly Dictionary<string, string> errors = new();

    private List<string> sizes = new();
    private List<ColorOption> colors = new();
    private readonly List<string> selectedSizes = new();
    private readonly List<string> selectedColors = new();

    private bool addingSize;
    private string newSize = string.Empty;
    private bool addingColor;
    private string newColorName = string.Empty;
    private string newColorHex = "#6c757d";

    private int lowStockAlert = 5;
    private string? oldCode;
    private decimal oldPurchasePrice;
    private decimal oldPrice;
    private bool wasDraft;

    private const string FixFieldsMessage = "Lal chinhito ghor gulo thik korun.";

    // Prothom save chapar por theke live validation
    private bool submitted;
    private bool lastPublish;

    private bool IsEdit => Id.HasValue;
    private bool Busy => saving || uploading;
    private string PublishLabel => IsEdit && !wasDraft ? "Update" : "Publish";
    private decimal Profit => product!.FinalPrice - product.PurchasePrice;

    private decimal PriceWithVat => Math.Round(product!.FinalPrice * (1 + product.VatPercent / 100m), 2);

    // Bikri dam er koto % profit
    private decimal? Margin => product!.FinalPrice > 0 ? Profit / product.FinalPrice * 100m : null;

    private string MarginText => Margin is decimal m ? $"({m:0.#}%)" : string.Empty;

    private string? CategoryName => categories.FirstOrDefault(c => c.Id == product!.CategoryId)?.Name;

    private string? BrandName => brands.FirstOrDefault(b => b.Id == product!.BrandId)?.Name;

    private static string StatusBadge(string status) => status switch
    {
        ProductStatus.Active => "bg-success-subtle text-success-emphasis",
        ProductStatus.Draft => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    private record CheckItem(string Label, bool Done);

    // Publish korar age ja ja lagbe (image optional kintu recommended)
    private List<CheckItem> Checklist
    {
        get
        {
            var p = product!;
            return new()
            {
                new("Product name", !string.IsNullOrWhiteSpace(p.Name)),
                new("SKU / product code", !string.IsNullOrWhiteSpace(p.Code)),
