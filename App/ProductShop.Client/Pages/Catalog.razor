@page "/catalog"
@attribute [RequirePermission(Perms.CatalogView)]

<PageTitle>Category / Brand</PageTitle>

<h1 class="h3 mb-3">Category / Brand / Shop / Supplier</h1>

<div class="row g-3">
    <div class="col-md-6">
        <NameListEditor TItem="Category" Title="Category" Url="@CatalogService.CategoriesUrl" />
    </div>
    <div class="col-md-6">
        <NameListEditor TItem="Brand" Title="Brand" Url="@CatalogService.BrandsUrl" />
    </div>
    <div class="col-md-6">
        <NameListEditor TItem="Shop" Title="Shop / Outlet" Url="@CatalogService.ShopsUrl" />
    </div>
    <div class="col-md-6">
        <NameListEditor TItem="Supplier" Title="Supplier" Url="@CatalogService.SuppliersUrl" />
    </div>
</div>
