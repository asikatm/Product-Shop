@page "/forgot-password"
@layout EmptyLayout
@attribute [PublicPage]
@inject AuthState Auth
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Forgot password</PageTitle>

<div class="login-shell">
    <div class="login-hero">
        <div class="d-flex align-items-center gap-2">
            <span class="app-brand-logo"><i class="bi bi-bag-heart"></i></span>
            <span class="fw-bold">@ShopName</span>
        </div>

        <div>
            <h2 class="mb-4">Password bhule gechen? Chinta nai.</h2>
            <div class="login-feature"><i class="bi bi-1-circle"></i><span>Username ar account er mobile number din</span></div>
            <div class="login-feature"><i class="bi bi-2-circle"></i><span>Mobile e SMS e 6 digit er OTP ashbe</span></div>
            <div class="login-feature"><i class="bi bi-3-circle"></i><span>OTP diye notun password set korun</span></div>
        </div>

        <div class="small text-secondary">© @DateTime.Today.Year @ShopName</div>
    </div>

    <div class="login-form">
        <div class="login-card" style="max-width:440px">
            <div class="d-lg-none d-flex align-items-center gap-2 mb-4">
                <span class="app-brand-logo text-white"><i class="bi bi-bag-heart"></i></span>
                <span class="fw-bold">@ShopName</span>
            </div>

            @if (done)
            {
                <div class="text-center">
                    <div class="stat-icon tone-success mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem;border-radius:50%">
                        <i class="bi bi-check2"></i>
                    </div>
                    <h1 class="h4 mb-2">Password bodle geche!</h1>
                    <p class="text-muted mb-4">Ekhon notun password diye login korun.</p>
                    <a class="btn btn-primary btn-lg w-100" href="login"><i class="bi bi-box-arrow-in-right me-2"></i>Login korun</a>
                </div>
            }
            else
            {
                <h1 class="h3 mb-1">Forgot password</h1>
                <p class="text-muted mb-4">
                    @(otpSent ? "SMS e pawa OTP ar notun password din." : "Mobile e OTP pathano hobe.")
                </p>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger d-flex gap-2"><i class="bi bi-exclamation-circle-fill"></i><span>@error</span></div>
                }
                @if (!string.IsNullOrEmpty(info))
                {
                    <div class="alert alert-info d-flex gap-2"><i class="bi bi-chat-dots-fill"></i><span>@info</span></div>
                }
                @if (!string.IsNullOrEmpty(devOtp))
                {
                    <div class="alert alert-warning small">
                        <strong>Test mode:</strong> SMS jay nai. OTP: <strong class="font-monospace">@devOtp</strong>
                    </div>
                }

                @if (!otpSent)
                {
                    <EditForm Model="forgot" OnValidSubmit="SendOtpAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <InputText class="form-control" @bind-Value="forgot.Username" autocomplete="username" />
                            </div>
                            <ValidationMessage For="() => forgot.Username" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Mobile number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                <InputText type="tel" class="form-control" @bind-Value="forgot.Phone" placeholder="01XXXXXXXXX" autocomplete="tel" />
                            </div>
                            <ValidationMessage For="() => forgot.Phone" />
                            <div class="pf-hint mt-1">Account e je number deya ache.</div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@busy">
                            @if (busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Please wait...</span>
                            }
                            else
                            {
                                <span>OTP pathan</span><i class="bi bi-send ms-2"></i>
                            }
                        </button>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="reset" OnValidSubmit="ResetAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">OTP</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                <InputText class="form-control font-monospace" @bind-Value="reset.Otp" inputmode="numeric" maxlength="6" placeholder="6 digit" autocomplete="one-time-code" />
                            </div>
                            <ValidationMessage For="() => reset.Otp" />
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label class="form-label">Notun password</label>
                                <InputText type="@(showPassword ? "text" : "password")" class="form-control" @bind-Value="reset.NewPassword" autocomplete="new-password" />
                                <ValidationMessage For="() => reset.NewPassword" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Confirm password</label>
                                <div class="input-group">
                                    <InputText type="@(showPassword ? "text" : "password")" class="form-control" @bind-Value="reset.ConfirmPassword" autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary" title="@(showPassword ? "Lukan" : "Dekhun")" @onclick="() => showPassword = !showPassword">
                                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="() => reset.ConfirmPassword" />
                            </div>
                            <div class="col-12 pf-hint mt-1">Kompokkhe 6 okkhor.</div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@busy">
                            @if (busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Please wait...</span>
                            }
                            else
                            {
                                <span>Password set korun</span><i class="bi bi-check2 ms-2"></i>
                            }
                        </button>
                    </EditForm>

                    <div class="d-flex justify-content-between mt-3 small">
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ChangeNumber">Number bodlan</button>
                        <button type="button" class="btn btn-link btn-sm p-0" disabled="@busy" @onclick="SendOtpAsync">Abar OTP pathan</button>
                    </div>
                }

                <p class="text-center text-muted mt-4 mb-0">
                    Password mone poreche? <a href="login" class="fw-semibold">Login korun</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    private ForgotPasswordRequest forgot = new();
    private ResetPasswordRequest reset = new();
    private string? error;
    private string? info;
    private string? devOtp;
    private bool busy;
    private bool otpSent;
    private bool done;
    private bool showPassword;

    private string ShopName => Config["Shop:Name"] ?? "Garments Showroom";

    protected override void OnInitialized()
    {
        if (Auth.IsLoggedIn) Nav.NavigateTo("");
    }

    private async Task SendOtpAsync()
    {
        error = null;
        info = null;
        devOtp = null;

        var phone = PhoneHelper.Normalize(forgot.Phone);
        if (phone == null)
        {
            error = "Mobile number thik nai. 11 digit, 01 diye shuru.";
            return;
        }
        forgot.Phone = phone;

        busy = true;
        try
        {
            var result = await AuthService.ForgotPasswordAsync(forgot);
            info = result.Message;
            devOtp = result.DevOtp;
            otpSent = true;
        }
        catch (HttpRequestException)
        {
            error = "API er sathe connect kora jay nai. API cholche kina check korun.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetAsync()
    {
        error = null;
        reset.Username = forgot.Username;
        reset.Phone = forgot.Phone;

        busy = true;
        try
        {
            await AuthService.ResetPasswordAsync(reset);
            done = true;
        }
        catch (HttpRequestException)
        {
            error = "API er sathe connect kora jay nai. API cholche kina check korun.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void ChangeNumber()
    {
        otpSent = false;
        error = info = devOtp = null;
        reset = new();
    }
}
