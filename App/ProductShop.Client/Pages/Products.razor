@page "/products"
@inject ProductService ProductService
@inject CatalogService CatalogService
@inject AuthState Auth
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>

<div class="page-head">
    <div>
        <h1 class="h3">Products</h1>
        <div class="page-sub">@(products == null ? "" : $"{products.Count} ta product · {products.Sum(p => p.TotalStock)} pcs stock")</div>
    </div>
    @if (Auth.IsAdmin)
    {
        <a class="btn btn-primary" href="product/add"><i class="bi bi-plus-lg me-1"></i> Add Product</a>
    }
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (products == null)
{
    <p>Loading...</p>
}
else if (products.Count == 0)
{
    <div class="alert alert-info">Kono product nai. @(Auth.IsAdmin ? "Notun product add korun." : "")</div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="Naam, code ba SKU diye khujun..." @bind="search" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select class="form-select" @bind="categoryId">
                <option value="0">Shob category</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select class="form-select" @bind="brandId">
                <option value="0">Shob brand</option>
                @foreach (var b in brands)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Code</th>
                        <th class="text-end">Sale Price</th>
                        <th>Size / Color Stock</th>
                        <th class="text-end">Total</th>
                        @if (Auth.IsAdmin)
                        {
                            <th class="text-end">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Filtered)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="thumb">
                                        @if (p.Images.Count > 0)
                                        {
                                            <img src="@ProductService.ImageUrl(p.Images[0].Url)" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image"></i>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-semibold">
                                            @p.Name
                                            @if (p.Status != ProductStatus.Active)
                                            {
                                                <span class="badge @(p.Status == ProductStatus.Draft ? "bg-warning-subtle text-warning-emphasis" : "bg-secondary-subtle text-secondary-emphasis") ms-1">@p.Status</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@string.Join(" · ", new[] { p.Category?.Name, p.Brand?.Name }.Where(x => x != null))</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-nowrap text-muted small">@p.Code</td>
                            <td class="text-end text-nowrap">@PriceRange(p)</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var v in p.Variants)
                                    {
                                        <StockBadge Quantity="v.Quantity" ReorderLevel="v.ReorderLevel" Label="@v.Label" />
                                    }
                                </div>
                            </td>
                            <td class="text-end fw-semibold">@p.TotalStock</td>
                            @if (Auth.IsAdmin)
                            {
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" href="product/edit/@p.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button class="btn btn-sm btn-outline-secondary text-danger" title="Delete" @onclick="() => DeleteAsync(p)"><i class="bi bi-trash"></i></button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Product>? products;
    private List<Category> categories = new();
    private List<Brand> brands = new();
    private string? error;
    private string search = string.Empty;
    private int categoryId;
    private int brandId;

    private IEnumerable<Product> Filtered => products!
        .Where(p => categoryId == 0 || p.CategoryId == categoryId)
        .Where(p => brandId == 0 || p.BrandId == brandId)
        .Where(p => string.IsNullOrWhiteSpace(search)
                 || p.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                 || (p.Code?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
                 || p.Variants.Any(v => v.Sku?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            products = await ProductService.GetAllAsync();
            categories = await CatalogService.GetCategoriesAsync();
            brands = await CatalogService.GetBrandsAsync();
        }
        catch (Exception ex)
        {
            products = new List<Product>();
            error = "API theke data ana jay nai. API cholche kina check korun. (" + ex.Message + ")";
        }
    }

    private static string PriceRange(Product p)
    {
        if (p.Variants.Count == 0) return "-";
        var min = p.Variants.Min(v => v.Price);
        var max = p.Variants.Max(v => v.Price);
        return min == max ? Fmt.Money(min) : $"{Fmt.Money(min)} - {Fmt.Money(max)}";
    }

    private async Task DeleteAsync(Product p)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"'{p.Name}' delete korte chan?");
        if (!ok) return;

        try
        {
            error = null;
            await ProductService.DeleteAsync(p.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
