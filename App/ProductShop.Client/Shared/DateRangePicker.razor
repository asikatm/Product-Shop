@* Finance page gulor somoy: preset ba nijer tarikh *@
<div class="d-flex flex-wrap align-items-center gap-2">
    <div class="btn-group btn-group-sm" role="group" aria-label="Period">
        @foreach (var p in Presets)
        {
            <button type="button" class="btn @(preset == p.Key ? "btn-primary" : "btn-outline-secondary")" @onclick="() => PickAsync(p.Key)">@p.Title</button>
        }
    </div>
    <div class="d-flex align-items-center gap-1">
        <input type="date" class="form-control form-control-sm" style="width:145px" value="@From.ToString("yyyy-MM-dd")" @onchange="e => SetDateAsync(e, true)" aria-label="From" />
        <span class="text-muted small">—</span>
        <input type="date" class="form-control form-control-sm" style="width:145px" value="@To.ToString("yyyy-MM-dd")" @onchange="e => SetDateAsync(e, false)" aria-label="To" />
    </div>
</div>

@code {
    [Parameter] public DateTime From { get; set; }
    [Parameter] public DateTime To { get; set; }
    [Parameter] public EventCallback<(DateTime From, DateTime To)> OnChange { get; set; }

    private static readonly (string Key, string Title)[] Presets =
    {
        ("month", "This month"), ("last", "Last month"), ("30d", "30 days"), ("year", "This year")
    };

    private string preset = "";

    protected override void OnParametersSet()
    {
        preset = Presets.FirstOrDefault(p => Range(p.Key) == (From.Date, To.Date)).Key ?? "";
    }

    public static (DateTime, DateTime) Range(string key)
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        return key switch
        {
            "last" => (monthStart.AddMonths(-1), monthStart.AddDays(-1)),
            "30d" => (today.AddDays(-29), today),
            "year" => (new DateTime(today.Year, 1, 1), today),
            _ => (monthStart, today)
        };
    }

    private Task PickAsync(string key)
    {
        var (f, t) = Range(key);
        return OnChange.InvokeAsync((f, t));
    }

    private Task SetDateAsync(ChangeEventArgs e, bool isFrom)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var d)) return Task.CompletedTask;
        var f = isFrom ? d : From;
        var t = isFrom ? To : d;
        if (t < f) (f, t) = (t, f);
        return OnChange.InvokeAsync((f, t));
    }
}
