@* Income / Expense / Transfer - icon + lekha (shudhu rong diye na) *@
<span class="badge @Css"><i class="bi @Icon me-1"></i>@Type</span>

@code {
    [Parameter, EditorRequired] public string Type { get; set; } = string.Empty;

    private string Css => Type switch
    {
        TxnTypes.Income => "bg-success-subtle text-success-emphasis",
        TxnTypes.Expense => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-primary-subtle text-primary-emphasis"
    };

    private string Icon => Type switch
    {
        TxnTypes.Income => "bi-arrow-down-left",
        TxnTypes.Expense => "bi-arrow-up-right",
        _ => "bi-arrow-left-right"
    };
}
