@inherits LayoutComponentBase
@inject AuthState Auth
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IConfiguration Config

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 no-print">
    <div class="container">
        <a class="navbar-brand" href="">@(Config["Shop:Name"] ?? "Garments Showroom")</a>
        <div class="navbar-nav me-auto flex-wrap">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink class="nav-link" href="sales">Sales</NavLink>
            <NavLink class="nav-link" href="customers">Customers</NavLink>
            <NavLink class="nav-link" href="products">Products</NavLink>
            @if (Auth.IsAdmin)
            {
                <NavLink class="nav-link" href="stock">Stock In</NavLink>
                <NavLink class="nav-link" href="catalog">Category / Brand</NavLink>
                <NavLink class="nav-link" href="users">Users</NavLink>
            }
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a class="btn btn-success btn-sm" href="sales/new">+ New Sale</a>
            <a class="nav-link text-light small" href="account" title="Password change">
                @Auth.User?.FullName <span class="badge bg-secondary">@Auth.User?.Role</span>
            </a>
            <button class="btn btn-outline-light btn-sm" @onclick="LogoutAsync">Logout</button>
        </div>
    </div>
</nav>

<main class="container pb-5">
    @Body
</main>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
