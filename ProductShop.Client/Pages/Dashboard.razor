@page "/"
@inject SaleService SaleService

<PageTitle>Dashboard</PageTitle>

<h1 class="h3 mb-3">Dashboard</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (summary == null)
{
    <p>Loading...</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Ajker Sale (@summary.TodayInvoices invoice)</div>
                <div class="value">@Fmt.Money(summary.TodaySales)</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Ajker Profit</div>
                <div class="value">@Fmt.Money(summary.TodayProfit)</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Ei Maser Sale</div>
                <div class="value">@Fmt.Money(summary.MonthSales)</div>
                <div class="small text-muted">Profit: @Fmt.Money(summary.MonthProfit)</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Total Due (Baki)</div>
                <div class="value text-danger">@Fmt.Money(summary.TotalDue)</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Total Products</div>
                <div class="value">@summary.TotalProducts</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Total Stock (pcs)</div>
                <div class="value">@summary.TotalStockQty</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Stock Value (kena dame)</div>
                <div class="value">@Fmt.Money(summary.StockValue)</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="label">Low Stock Products</div>
                <div class="value @(summary.LowStockCount > 0 ? "text-warning" : "")">@summary.LowStockCount</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between">
                    <span>Low Stock</span>
                    <a href="stock/new">Stock In</a>
                </div>
                @if (summary.LowStockProducts.Count == 0)
                {
                    <div class="card-body text-muted">Shob product er stock thik ache.</div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Product</th><th class="text-end">Stock</th><th class="text-end">Reorder</th></tr></thead>
                        <tbody>
                            @foreach (var p in summary.LowStockProducts)
                            {
                                <tr>
                                    <td>@p.Name</td>
                                    <td class="text-end"><StockBadge Product="p" /></td>
                                    <td class="text-end">@p.ReorderLevel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between">
                    <span>Recent Sales</span>
                    <a href="sales">Shob dekhun</a>
                </div>
                @if (summary.RecentSales.Count == 0)
                {
                    <div class="card-body text-muted">Ekhono kono sale nai.</div>
                }
                else
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light"><tr><th>Invoice</th><th>Date</th><th>Customer</th><th class="text-end">Total</th><th class="text-end">Due</th></tr></thead>
                        <tbody>
                            @foreach (var s in summary.RecentSales)
                            {
                                <tr>
                                    <td><a href="sales/@s.Id">@s.InvoiceNo</a></td>
                                    <td>@Fmt.Date(s.SaleDate)</td>
                                    <td>@(s.CustomerName ?? "Walk-in")</td>
                                    <td class="text-end">@Fmt.Money(s.GrandTotal)</td>
                                    <td class="text-end">@Fmt.Money(s.DueAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@code {
    private DashboardSummary? summary;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await SaleService.GetDashboardAsync();
        }
        catch (Exception ex)
        {
            error = "API theke data ana jay nai. API cholche kina check korun. (" + ex.Message + ")";
        }
    }
}
