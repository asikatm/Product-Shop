@page "/login"
@layout EmptyLayout
@inject AuthState Auth
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Login</PageTitle>

<div class="row justify-content-center">
    <div class="col-sm-8 col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <h1 class="h3 mb-1">@(Config["Shop:Name"] ?? "Garments Showroom")</h1>
            <div class="text-muted">Login korun</div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger">@error</div>
                }

                <EditForm Model="request" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <InputText class="form-control" @bind-Value="request.Username" autocomplete="username" />
                        <ValidationMessage For="() => request.Username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText type="password" class="form-control" @bind-Value="request.Password" autocomplete="current-password" />
                        <ValidationMessage For="() => request.Password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@busy">@(busy ? "Please wait..." : "Login")</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest request = new();
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsLoggedIn)
        {
            Nav.NavigateTo("");
            return;
        }

        // Meyad shesh howa purono token thakle muche fela
        await AuthService.LogoutAsync();
    }

    private async Task LoginAsync()
    {
        busy = true;
        error = null;

        try
        {
            await AuthService.LoginAsync(request);
            Nav.NavigateTo("");
        }
        catch (HttpRequestException)
        {
            error = "API er sathe connect kora jay nai. API cholche kina check korun.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
