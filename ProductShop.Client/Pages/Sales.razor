@page "/sales"
@inject SaleService SaleService
@inject IJSRuntime JS

<PageTitle>Sales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sales</h1>
    <a class="btn btn-success" href="sales/new">+ New Sale</a>
</div>

<div class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">From</label>
            <input type="date" class="form-control" @bind="from" />
        </div>
        <div class="col-auto">
            <label class="form-label">To</label>
            <input type="date" class="form-control" @bind="to" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" @onclick="LoadAsync">Search</button>
        </div>
        <div class="col-auto form-check ms-2 mb-2">
            <input class="form-check-input" type="checkbox" id="dueOnly" @bind="dueOnly" />
            <label class="form-check-label" for="dueOnly">Shudhu baki (due) wala</label>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (sales == null)
{
    <p>Loading...</p>
}
else if (!Filtered.Any())
{
    <div class="alert alert-info">Ei date er moddhe kono sale nai.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Invoice</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th class="text-end">Items</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Due</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Filtered)
                    {
                        <tr>
                            <td><a href="sales/@s.Id">@s.InvoiceNo</a></td>
                            <td>@Fmt.Date(s.SaleDate)</td>
                            <td>
                                @(s.CustomerName ?? "Walk-in")
                                @if (!string.IsNullOrEmpty(s.CustomerPhone))
                                {
                                    <div class="small text-muted">@s.CustomerPhone</div>
                                }
                            </td>
                            <td class="text-end">@s.Items.Sum(i => i.Quantity) pcs</td>
                            <td class="text-end">@Fmt.Money(s.GrandTotal)</td>
                            <td class="text-end">@Fmt.Money(s.PaidAmount)</td>
                            <td class="text-end @(s.DueAmount > 0 ? "text-danger" : "")">@Fmt.Money(s.DueAmount)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="sales/@s.Id">Invoice</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(s)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="4" class="text-end">Total</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(s => s.GrandTotal))</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(s => s.PaidAmount))</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(s => s.DueAmount))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private List<Sale>? sales;
    private string? error;
    private bool dueOnly;
    private DateTime? from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? to = DateTime.Today;

    private IEnumerable<Sale> Filtered => dueOnly ? sales!.Where(s => s.DueAmount > 0) : sales!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            sales = await SaleService.GetAllAsync(from, to);
        }
        catch (Exception ex)
        {
            sales = new List<Sale>();
            error = "Data ana jay nai: " + ex.Message;
        }
    }

    private async Task DeleteAsync(Sale s)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"{s.InvoiceNo} delete korte chan? Product gulo stock e ferot jabe.");
        if (!ok) return;

        try
        {
            await SaleService.DeleteAsync(s.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
