@page "/products"
@inject ProductService ProductService
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-primary" href="product/add">+ Add Product</a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (products == null)
{
    <p>Loading...</p>
}
else if (products.Count == 0)
{
    <div class="alert alert-info">Kono product nai. Notun product add korun.</div>
}
else
{
    <input class="form-control mb-3" placeholder="Product name diye khujun..." @bind="search" @bind:event="oninput" />

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Purchase Price</th>
                        <th class="text-end">Sale Price</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Filtered)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Name</td>
                            <td>@p.Description</td>
                            <td class="text-end">@Fmt.Money(p.PurchasePrice)</td>
                            <td class="text-end">@Fmt.Money(p.Price)</td>
                            <td class="text-end"><StockBadge Product="p" /></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="product/edit/@p.Id">Edit</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(p)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Product>? products;
    private string? error;
    private string search = string.Empty;

    private IEnumerable<Product> Filtered => string.IsNullOrWhiteSpace(search)
        ? products!
        : products!.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            products = new List<Product>();
            error = "API theke data ana jay nai. API cholche kina check korun. (" + ex.Message + ")";
        }
    }

    private async Task DeleteAsync(Product p)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"'{p.Name}' delete korte chan?");
        if (!ok) return;

        try
        {
            error = null;
            await ProductService.DeleteAsync(p.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
