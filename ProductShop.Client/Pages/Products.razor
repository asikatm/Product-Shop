@page "/"
@inject ProductService ProductService
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Product List</h1>
    <a class="btn btn-primary" href="product/add">+ Add Product</a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (products == null)
{
    <p>Loading...</p>
}
else if (products.Count == 0)
{
    <div class="alert alert-info">Kono product nai. Notun product add korun.</div>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Quantity</th>
                    <th>Created</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Name</td>
                        <td>@p.Description</td>
                        <td class="text-end">@p.Price.ToString("N2")</td>
                        <td class="text-end">@p.Quantity</td>
                        <td>@p.CreatedAt.ToString("dd-MMM-yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="product/edit/@p.Id">Edit</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(p)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Product>? products;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            products = new List<Product>();
            error = "API theke data ana jay nai. API cholche kina check korun. (" + ex.Message + ")";
        }
    }

    private async Task DeleteAsync(Product p)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"'{p.Name}' delete korte chan?");
        if (!ok) return;

        try
        {
            await ProductService.DeleteAsync(p.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = "Delete kora jay nai: " + ex.Message;
        }
    }
}
