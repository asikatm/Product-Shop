@page "/customers"
@inject CustomerService CustomerService
@inject NavigationManager Nav

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <button class="btn btn-primary" @onclick="() => form = new Customer()">+ Add Customer</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (form != null)
{
    <div class="card mb-3">
        <div class="card-header">Notun Customer</div>
        <div class="card-body">
            <EditForm Model="form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="form.Name" />
                        <ValidationMessage For="() => form.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Phone</label>
                        <InputText class="form-control" @bind-Value="form.Phone" />
                        <ValidationMessage For="() => form.Phone" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Address</label>
                        <InputText class="form-control" @bind-Value="form.Address" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-success" disabled="@saving">@(saving ? "Saving..." : "Save")</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => form = null">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (customers == null)
{
    <p>Loading...</p>
}
else if (customers.Count == 0)
{
    <div class="alert alert-info">Ekhono kono customer nai. Sale er somoy phone number dile customer automatic save hoy.</div>
}
else
{
    <div class="row g-2 mb-3 align-items-center">
        <div class="col-md-6">
            <input class="form-control" placeholder="Naam ba phone diye khujun..." @bind="search" @bind:event="oninput" />
        </div>
        <div class="col-auto form-check ms-2">
            <input class="form-check-input" type="checkbox" id="dueOnly" @bind="dueOnly" />
            <label class="form-check-label" for="dueOnly">Shudhu baki wala</label>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th class="text-end">Mot Kena</th>
                        <th class="text-end">Baki</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Filtered)
                    {
                        <tr>
                            <td><a href="customers/@c.Id">@c.Name</a></td>
                            <td>@c.Phone</td>
                            <td class="small">@c.Address</td>
                            <td class="text-end">@Fmt.Money(c.TotalPurchase)</td>
                            <td class="text-end @(c.TotalDue > 0 ? "text-danger fw-semibold" : "")">@Fmt.Money(c.TotalDue)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="customers/@c.Id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="3" class="text-end">Total</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(c => c.TotalPurchase))</td>
                        <td class="text-end">@Fmt.Money(Filtered.Sum(c => c.TotalDue))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private List<Customer>? customers;
    private Customer? form;
    private string? error;
    private bool saving;
    private bool dueOnly;
    private string search = string.Empty;

    private IEnumerable<Customer> Filtered => customers!
        .Where(c => !dueOnly || c.TotalDue > 0)
        .Where(c => string.IsNullOrWhiteSpace(search)
                 || c.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                 || c.Phone.Contains(search));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            customers = await CustomerService.GetAllAsync();
        }
        catch (Exception ex)
        {
            customers = new List<Customer>();
            error = "Data ana jay nai: " + ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;

        try
        {
            var created = await CustomerService.CreateAsync(form!);
            Nav.NavigateTo($"customers/{created.Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
