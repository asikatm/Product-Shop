@page "/users"
@attribute [AdminOnly]
@inject UserService UserService

<PageTitle>Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <button class="btn btn-primary" @onclick="StartAdd">+ Add User</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (form != null)
{
    <div class="card mb-3">
        <div class="card-header">@(form.Id == 0 ? "Notun User" : "Edit User")</div>
        <div class="card-body">
            <EditForm Model="form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Username</label>
                        <InputText class="form-control" @bind-Value="form.Username" />
                        <ValidationMessage For="() => form.Username" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Full Name</label>
                        <InputText class="form-control" @bind-Value="form.FullName" />
                        <ValidationMessage For="() => form.FullName" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Role</label>
                        <InputSelect class="form-select" @bind-Value="form.Role">
                            @foreach (var role in Roles.All)
                            {
                                <option value="@role">@role</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Password</label>
                        <InputText type="password" class="form-control" @bind-Value="form.Password" />
                        @if (form.Id != 0)
                        {
                            <div class="form-text">Khali rakhle password change hobe na.</div>
                        }
                        <ValidationMessage For="() => form.Password" />
                    </div>
                    <div class="col-md-1 d-flex align-items-center">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input" id="active" @bind-Value="form.IsActive" />
                            <label class="form-check-label" for="active">Active</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success" disabled="@saving">@(saving ? "Saving..." : "Save")</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => form = null">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="alert alert-light border small">
    <strong>Admin</strong> shob kichu korte pare. <strong>Salesman</strong> shudhu sale, customer ar baki joma nite pare;
    kena dam, profit, stock in ar settings dekhte pare na.
</div>

@if (users == null)
{
    <p>Loading...</p>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr>
                            <td>@u.Username</td>
                            <td>@u.FullName</td>
                            <td><span class="badge @(u.Role == Roles.Admin ? "bg-primary" : "bg-secondary")">@u.Role</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(u)">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<UserInfo>? users;
    private UserSaveRequest? form;
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            users = await UserService.GetAllAsync();
        }
        catch (Exception ex)
        {
            users = new List<UserInfo>();
            error = "Data ana jay nai: " + ex.Message;
        }
    }

    private void StartAdd() => form = new UserSaveRequest();

    private void StartEdit(UserInfo u) => form = new UserSaveRequest
    {
        Id = u.Id,
        Username = u.Username,
        FullName = u.FullName,
        Role = u.Role,
        IsActive = u.IsActive
    };

    private async Task SaveAsync()
    {
        saving = true;
        error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(form!.Password))
                form.Password = null;

            if (form.Id == 0)
                await UserService.CreateAsync(form);
            else
                await UserService.UpdateAsync(form);

            form = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
