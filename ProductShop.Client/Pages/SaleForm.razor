@page "/sales/new"
@inject ProductService ProductService
@inject SaleService SaleService
@inject CustomerService CustomerService
@inject NavigationManager Nav

<PageTitle>New Sale</PageTitle>

<h1 class="h3 mb-3">New Sale</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (products == null)
{
    <p>Loading...</p>
}
else if (options.Count == 0)
{
    <div class="alert alert-info">Ekhono kono product nai. Admin ke product add korte bolun.</div>
}
else
{
    @* Form er baire, jate scanner er Enter e form submit na hoy *@
    <div class="card mb-3">
        <div class="card-body">
            <input class="form-control form-control-lg" placeholder="Barcode / SKU scan korun ba likhe Enter chapun" @bind="scan" @bind:event="oninput" @onkeydown="OnScanKeyDown" />
            @if (!string.IsNullOrEmpty(scanMessage))
            {
                <div class="small text-danger mt-1">@scanMessage</div>
            }
        </div>
    </div>

    <EditForm Model="sale" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="card mb-3">
            <div class="card-body row g-3">
                <div class="col-md-3">
                    <label class="form-label">Date</label>
                    <InputDate class="form-control" @bind-Value="sale.SaleDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Customer Phone</label>
                    <input class="form-control" list="customer-phones" placeholder="01XXXXXXXXX" @bind="sale.CustomerPhone" @bind:event="oninput" @bind:after="OnPhoneChanged" />
                    <datalist id="customer-phones">
                        @foreach (var c in customers)
                        {
                            <option value="@c.Phone">@c.Name</option>
                        }
                    </datalist>
                    @if (customer != null)
                    {
                        <div class="small text-success mt-1">
                            Purono customer: <a href="customers/@customer.Id" target="_blank">@customer.Name</a>
                            @if (customer.TotalDue > 0)
                            {
                                <span class="text-danger"> · Ager baki @Fmt.Money(customer.TotalDue)</span>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(sale.CustomerPhone))
                    {
                        <div class="small text-muted mt-1">Notun customer hisebe save hobe.</div>
                    }
                </div>
                <div class="col-md-5">
                    <label class="form-label">Customer Name</label>
                    <InputText class="form-control" @bind-Value="sale.CustomerName" placeholder="Walk-in customer" disabled="@(customer != null)" />
                    <ValidationMessage For="() => sale.CustomerName" />
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:260px">Product / Size / Color</th>
                            <th class="text-end">Stock</th>
                            <th style="width:110px">Qty</th>
                            <th style="width:140px">Unit Price</th>
                            <th class="text-end">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in sale.Items)
                        {
                            var option = Find(line.ProductVariantId);
                            var over = option != null && line.Quantity > option.Variant.Quantity;
                            <tr @key="line">
                                <td>
                                    <select class="form-select" value="@line.ProductVariantId" @onchange="e => OnVariantChanged(line, e.Value)">
                                        <option value="0">-- Product select korun --</option>
                                        @foreach (var p in products)
                                        {
                                            <optgroup label="@p.Name">
                                                @foreach (var v in p.Variants)
                                                {
                                                    <option value="@v.Id" disabled="@(v.Quantity <= 0)">@p.Name — @v.Label (Stock: @v.Quantity)</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </td>
                                <td class="text-end">
                                    @if (option != null)
                                    {
                                        <StockBadge Quantity="option.Variant.Quantity" ReorderLevel="option.Variant.ReorderLevel" />
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <input type="number" min="1" class="form-control @(over ? "is-invalid" : "")" @bind="line.Quantity" @bind:event="oninput" />
                                </td>
                                <td><input type="number" min="0" step="0.01" class="form-control" @bind="line.UnitPrice" /></td>
                                <td class="text-end">@Fmt.Money(line.Quantity * line.UnitPrice)</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => sale.Items.Remove(line)">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body border-top d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLine">+ Add Row</button>
                <span class="text-muted">@sale.Items.Where(i => i.ProductVariantId > 0).Sum(i => i.Quantity) pcs</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Note</label>
                <InputTextArea class="form-control" rows="5" @bind-Value="sale.Note" />
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sub Total</span>
                            <strong>@Fmt.Money(SubTotal)</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Discount</span>
                            <input type="number" min="0" step="0.01" class="form-control w-50 text-end" @bind="sale.Discount" />
                        </div>
                        <div class="d-flex justify-content-between mb-2 fs-5">
                            <span>Grand Total</span>
                            <strong>@Fmt.Money(GrandTotal)</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>
                                Paid
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="PayFull">(Full)</button>
                            </span>
                            <input type="number" min="0" step="0.01" class="form-control w-50 text-end" @bind="sale.PaidAmount" />
                        </div>
                        @if (sale.PaidAmount > GrandTotal)
                        {
                            <div class="d-flex justify-content-between text-success">
                                <span>Change (ferot)</span>
                                <strong>@Fmt.Money(sale.PaidAmount - GrandTotal)</strong>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between @(GrandTotal - sale.PaidAmount > 0 ? "text-danger" : "")">
                                <span>Due (baki)</span>
                                <strong>@Fmt.Money(GrandTotal - sale.PaidAmount)</strong>
                            </div>
                            @if (GrandTotal - sale.PaidAmount > 0 && string.IsNullOrWhiteSpace(sale.CustomerPhone))
                            {
                                <div class="small text-danger mt-1">Baki rakhte customer er phone number din.</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success btn-lg" disabled="@saving">@(saving ? "Saving..." : "Save Sale")</button>
            <a class="btn btn-secondary btn-lg" href="sales">Cancel</a>
        </div>
    </EditForm>
}

@code {
    private List<Product>? products;
    private Dictionary<int, VariantOption> options = new();
    private List<Customer> customers = new();
    private Customer? customer;
    private Sale sale = new();
    private string? error;
    private bool saving;
    private string scan = string.Empty;
    private string? scanMessage;

    private decimal SubTotal => sale.Items.Sum(i => i.Quantity * i.UnitPrice);
    private decimal GrandTotal => SubTotal - sale.Discount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Draft / Inactive product bikri kora jabe na
            products = (await ProductService.GetAllAsync()).Where(p => p.Variants.Count > 0 && p.Status == ProductStatus.Active).ToList();
            options = VariantOption.Build(products);
            customers = await CustomerService.GetAllAsync();
            AddLine();
        }
        catch (Exception ex)
        {
            error = "Data ana jay nai: " + ex.Message;
        }
    }

    private VariantOption? Find(int variantId) => options.GetValueOrDefault(variantId);

    private void AddLine() => sale.Items.Add(new SaleItem { Quantity = 1 });

    private void PayFull() => sale.PaidAmount = GrandTotal;

    // Phone mile gele purono customer select hoy
    private void OnPhoneChanged()
    {
        var phone = sale.CustomerPhone?.Trim();
        var match = string.IsNullOrEmpty(phone) ? null : customers.FirstOrDefault(c => c.Phone == phone);

        if (match != null)
        {
            customer = match;
            sale.CustomerId = match.Id;
            sale.CustomerName = match.Name;
        }
        else if (customer != null)
        {
            customer = null;
            sale.CustomerId = null;
            sale.CustomerName = null;
        }
    }

    private void OnVariantChanged(SaleItem line, object? value)
    {
        line.ProductVariantId = int.TryParse(value?.ToString(), out var id) ? id : 0;
        var option = Find(line.ProductVariantId);
        line.ProductName = option?.Product.Name ?? string.Empty;
        line.VariantName = option?.Variant.Label ?? string.Empty;
        line.UnitPrice = option?.Variant.Price ?? 0;
    }

    private void OnScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;

        var option = VariantOption.FindBySku(options.Values, scan);
        if (option == null)
        {
            scanMessage = $"'{scan}' SKU pawa jay nai.";
            return;
        }
        if (option.Variant.Quantity <= 0)
        {
            scanMessage = $"{option.Text} er stock nai.";
            return;
        }

        scanMessage = null;
        scan = string.Empty;

        // Same item age thakle qty bare, na hole khali row / notun row te boshe
        var line = sale.Items.FirstOrDefault(i => i.ProductVariantId == option.Variant.Id);
        if (line != null)
        {
            line.Quantity++;
            return;
        }

        line = sale.Items.FirstOrDefault(i => i.ProductVariantId == 0);
        if (line == null)
        {
            line = new SaleItem { Quantity = 1 };
            sale.Items.Add(line);
        }
        OnVariantChanged(line, option.Variant.Id);
    }

    private async Task SaveAsync()
    {
        error = null;

        var lines = sale.Items.Where(i => i.ProductVariantId > 0).ToList();
        if (lines.Count == 0)
        {
            error = "Kompokkhe ekta product select korun.";
            return;
        }
        if (lines.Any(i => i.Quantity <= 0))
        {
            error = "Quantity 0 er beshi hote hobe.";
            return;
        }
        foreach (var group in lines.GroupBy(i => i.ProductVariantId))
        {
            var option = Find(group.Key)!;
            var need = group.Sum(i => i.Quantity);
            if (need > option.Variant.Quantity)
            {
                error = $"'{option.Text}' er stock ache {option.Variant.Quantity}, apni diyechen {need}.";
                return;
            }
        }
        if (sale.Discount < 0 || sale.Discount > SubTotal)
        {
            error = "Discount 0 theke sub total er moddhe hote hobe.";
            return;
        }
        if (sale.PaidAmount < 0)
        {
            error = "Paid amount negative hote parbe na.";
            return;
        }
        if (GrandTotal - sale.PaidAmount > 0 && string.IsNullOrWhiteSpace(sale.CustomerPhone))
        {
            error = "Baki rakhte customer er phone number dite hobe.";
            return;
        }

        saving = true;
        try
        {
            sale.Items = lines;
            var created = await SaleService.CreateAsync(sale);
            Nav.NavigateTo($"sales/{created.Id}");
        }
        catch (Exception ex)
        {
            error = "Save kora jay nai: " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
